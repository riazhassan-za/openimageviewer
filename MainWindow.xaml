<Window x:Class="OpenImageViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenImageViewer" Width="1100" Height="750"
        Background="#1E1E1E"
        PreviewKeyDown="Window_PreviewKeyDown"
        AllowDrop="True" Drop="Window_Drop">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#2B2B2B" BorderBrush="#3A3A3A"
                BorderThickness="0,0,0,1" Padding="4">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Style="{StaticResource ToolButton}" Content="Open" ToolTip="Open (Ctrl+O)" Click="Open_Click" />
                    <Rectangle Style="{StaticResource ToolSeparator}" />
                    <Button Style="{StaticResource ToolButton}" Content="◀" ToolTip="Previous (Left / Up / Backspace / Page Up)" Click="Prev_Click" />
                    <Button Style="{StaticResource ToolButton}" Content="▶" ToolTip="Next (Right / Down / Space / Page Down)" Click="Next_Click" />
                    <Rectangle Style="{StaticResource ToolSeparator}" />
                    <Button Style="{StaticResource ToolButton}" Content="−" ToolTip="Zoom out (scroll down, - or _)" Click="ZoomOut_Click" />
                    <Button Style="{StaticResource ToolButton}" Content="+" ToolTip="Zoom in (scroll up, + or =)" Click="ZoomIn_Click" />
                    <Button Style="{StaticResource ToolButton}" Content="Fit" ToolTip="Fit to window (F)" Click="Fit_Click" />
                    <Button Style="{StaticResource ToolButton}" Content="⛶" ToolTip="Fullscreen (F11, Esc to exit)" Click="Fullscreen_Click" />
                    <!-- E962 is the mouse glyph in Segoe MDL2 Assets (built into Windows 10/11). -->
                    <ToggleButton x:Name="WheelLock" Style="{StaticResource ToolToggle}"
                                  Content="&#xE962;" FontFamily="Segoe MDL2 Assets"
                                  ToolTip="Mouse wheel lock (M or right-click the image): when on, scroll up/down goes to the previous/next image instead of zooming" />
                    <Rectangle Style="{StaticResource ToolSeparator}" />
                </StackPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Content="About" Click="About_Click" />
                <Rectangle DockPanel.Dock="Right" Style="{StaticResource ToolSeparator}" />
                <TextBlock x:Name="StatusText" DockPanel.Dock="Right" Foreground="#AAA"
                           VerticalAlignment="Center" Margin="8,0" />
                <TextBlock x:Name="PathText" Foreground="#DDD" VerticalAlignment="Center" Margin="4,0"
                           TextTrimming="CharacterEllipsis" Cursor="Hand"
                           HorizontalAlignment="Left"
                           ToolTip="Click to open another file from this folder"
                           MouseLeftButtonUp="Open_Click">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="TextDecorations" Value="Underline" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>
        </Border>

        <Grid x:Name="Viewport" ClipToBounds="True" Background="#1E1E1E"
              MouseWheel="Viewport_MouseWheel"
              MouseRightButtonUp="Viewport_MouseRightButtonUp"
              MouseLeftButtonDown="Viewport_MouseLeftButtonDown"
              MouseMove="Viewport_MouseMove"
              MouseLeftButtonUp="Viewport_MouseLeftButtonUp">
            <Image x:Name="ImageView" Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality">
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="Scale" />
                        <TranslateTransform x:Name="Translate" />
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>
            <TextBlock x:Name="HintText" Text="Open an image (Ctrl+O)" Foreground="#888"
                       FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
    </DockPanel>
</Window>
